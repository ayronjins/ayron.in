server {
    listen 80;
    listen [::]:80;
    server_name ayron.in www.ayron.in;
    server_tokens off;
    return 301 https://ayron.in$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ayron.in;

    root /home/ayron/khs-ai-portfolio;
    index index.html;
    charset utf-8;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/ayron.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ayron.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'; upgrade-insecure-requests" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "0" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/plain text/css application/javascript application/json application/manifest+json application/xml image/svg+xml;

    error_page 404 /404.html;

    location = /404.html {
        internal;
        expires -1;
    }

    location = /robots.txt {
        default_type text/plain;
        try_files /robots.txt =404;
        expires 1h;
    }

    location = /humans.txt {
        default_type text/plain;
        try_files /humans.txt =404;
        expires 1h;
    }

    location = /llms.txt {
        default_type text/plain;
        try_files /llms.txt =404;
        expires 1h;
    }

    location = /.well-known/security.txt {
        default_type text/plain;
        try_files /.well-known/security.txt =404;
        expires 1h;
    }

    location = /sitemap.xml {
        default_type application/xml;
        try_files /sitemap.xml =404;
        expires 1h;
    }

    location = /site.webmanifest {
        default_type application/manifest+json;
        try_files /site.webmanifest =404;
        expires 1d;
    }

    location = /SEO_HANDOFF.md {
        return 404;
    }

    location = /SEO_CHANGELOG.md {
        return 404;
    }

    location = /analytics/script.js {
        proxy_pass http://127.0.0.1:3002/script.js;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 1h;
    }

    location = /analytics/api/send {
        proxy_pass http://127.0.0.1:3002/api/send;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/tools/domain {
        proxy_pass http://127.0.0.1:3100/api/tools/domain;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 12s;
    }

    location = /api/tools/site {
        proxy_pass http://127.0.0.1:3100/api/tools/site;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 12s;
    }

    location ^~ /analytics/ {
        return 404;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        expires 30d;
        access_log off;
    }

    location / {
        try_files $uri $uri/ =404;
        expires -1;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
